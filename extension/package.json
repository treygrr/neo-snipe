{
  "name": "neo-snipe-extension",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "node test/e2e.mjs",
    "build:safari": "vite build --mode safari",
    "test:safari": "node test/bundle.mjs",
    "build:safari-app": "bash scripts/build-safari-app.sh",
    "test:detect": "node --test test/detect.test.mjs",
    "test:jellyneo": "node --test test/jellyneo.test.mjs",
    "build:firefox": "vite build --mode firefox",
    "test:firefox": "NS_TARGET=firefox node test/bundle.mjs",
    "build:all": "npm run build && npm run build:firefox && npm run build:safari",
    "release": "node scripts/release.mjs",
    "dev:browser": "node scripts/dev-browser.mjs",
    "fixture": "node scripts/dev-browser.mjs --fixture",
    "test:foodclub": "node --test test/foodclub.test.mjs",
    "test:foodclub-fill": "node --test test/foodclub-fill.test.mjs",
    "icons": "node scripts/make-icons.mjs",
    "test:icons": "node --test test/icons.test.mjs"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "linkedom": "^0.18.13",
    "vue": "^3.5.13",
    "vuetify": "^3.7.6"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@vitejs/plugin-vue": "^5.2.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1",
    "vite": "^5.4.11",
    "vite-plugin-vuetify": "^2.0.4"
  }
}
