# Shared secret the extension must send as X-NeoSnipe-Token. Required.
NEOSNIPE_TOKEN=change-me

PORT=8787

# Playwright
HEADLESS=true
CONTEXT_POOL_SIZE=2
# Override the Desktop Safari UA if you want to pin a specific version.
# SAFARI_UA=

# Politeness toward Jelly Neo
SCRAPE_CONCURRENCY=2
SCRAPE_MIN_INTERVAL_MS=1000

# Cache
CACHE_DB=data/cache.db
HIT_TTL_MS=86400000
MISS_TTL_MS=3600000
